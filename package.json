{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:security": "NODE_ENV=test tsx tests/security/tst_tenant-isolation.ts",
    "test:platform": "NODE_ENV=test tsx tests/security/tst_platform-authorization.ts",
    "test:subscription": "NODE_ENV=test tsx tests/security/tst_subscription-entitlements.ts",
    "test:ai": "NODE_ENV=test tsx tests/security/tst_ai-multi-tenant-isolation.ts",
    "test:phase7": "NODE_ENV=test tsx tests/security/tst_phase7-preview-and-migration.ts",
    "test:phase8": "tsx tests/security/tst_phase8-security-audit.ts",
    "test:phase9": "tsx tests/security/tst_phase9-production-hardening.ts",
    "test:phase10": "tsx tests/security/tst_data-migration.ts && tsx tests/security/tst_storage-isolation.ts",
    "test:phase11": "NODE_ENV=test tsx tests/security/tst_phase11-cutover-and-e2e.ts",
    "test:phase12": "NODE_ENV=test tsx tests/security/tst_live-firestore-access.ts",
    "test:adc": "NODE_ENV=test tsx tests/security/tst_adc-and-firestore-prod.ts",
    "test": "npm run test:security && npm run test:platform && npm run test:subscription && npm run test:ai && npm run test:phase7 && npm run test:phase8 && npm run test:phase9 && npm run test:phase10 && npm run test:phase11 && npm run test:phase12 && npm run test:adc"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "@jimp/wasm-webp": "^1.6.1",
    "@react-google-maps/api": "^2.20.8",
    "@tailwindcss/vite": "^4.1.14",
    "@vis.gl/react-google-maps": "^1.8.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.16.0",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.0",
    "express": "^4.21.2",
    "firebase": "^12.13.0",
    "html-to-text": "^10.0.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14"
  },
  "overrides": {
    "node-domexception": "file:./local-node-domexception"
  }
}
