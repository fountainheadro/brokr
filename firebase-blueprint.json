        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMovedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["tenantId", "status", "createdAt", "updatedAt"]
    },
    "LeadSummary": {
      "title": "Slim Agency Lead Summary Projection",
