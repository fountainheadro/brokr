        "isPublicSnapshot": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["shareCode", "entityKind", "title", "isPublicSnapshot", "updatedAt"]
    },
    "WorkerLease": {
      "title": "WorkerLease",
      "description": "Distributed Firestore worker lease with monotonic fencing token",
      "type": "object",
      "properties": {
        "lockKey": { "type": "string" },
        "ownerId": { "type": "string" },
        "fencingToken": { "type": "number" },
        "acquiredAt": { "type": "string" },
        "leaseExpiresAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["lockKey", "ownerId", "fencingToken", "acquiredAt", "leaseExpiresAt"]
    },
    "OutboxEvent": {
      "title": "OutboxEvent",
      "description": "Transactional outbox event with idempotency key, retry state, and DLQ replay metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventType": { "type": "string" },
        "tenantId": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "status": { "type": "string" },
        "attempts": { "type": "number" },
        "maxAttempts": { "type": "number" },
        "nextAttemptAt": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "eventType", "tenantId", "idempotencyKey", "status", "attempts", "nextAttemptAt"]
    },
    "JobRun": {
      "title": "JobRun",
      "description": "Operational ledger entry for scheduled or dispatched backend worker executions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobName": { "type": "string" },
        "tenantId": { "type": "string" },
        "triggeredBy": { "type": "string" },
        "status": { "type": "string" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "jobName", "triggeredBy", "status", "startedAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "Durable AI voice call session metadata scoped to a tenant",
      "type": "object",
      "properties": {
        "callSid": { "type": "string" },
        "tenantId": { "type": "string" },
        "ownerUid": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "status": { "type": "string" },
        "lastSeq": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["callSid", "tenantId", "status", "lastSeq", "createdAt"]
    },
    "CallSessionEvent": {
      "title": "CallSessionEvent",
      "description": "Monotonically sequenced transcript event inside an AI voice call session",
      "type": "object",
      "properties": {
        "callSid": { "type": "string" },
        "tenantId": { "type": "string" },
        "seq": { "type": "number" },
        "speaker": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["callSid", "tenantId", "seq", "speaker", "text"]
    },
    "PublicPropertyMedia": {
      "title": "Public Property Media Blob",
      "description": "Cross-instance web-optimized public property image persisted in Firestore when external GCS credentials are unavailable",
      "type": "object",
      "properties": {
        "objectKey": {
          "type": "string",
          "minLength": 10,
          "maxLength": 512,
          "pattern": "^tenants/[a-zA-Z0-9_.\\-]+/properties/[a-zA-Z0-9_.\\-]+/[a-zA-Z0-9_.\\-]+$"
        },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "entityId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "mimeType": { "type": "string", "enum": ["image/jpeg", "image/png", "image/webp"] },
        "dataBase64": { "type": "string", "minLength": 16, "maxLength": 820000 },
        "sizeBytes": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time", "maxLength": 64 }
      },
      "required": ["objectKey", "tenantId", "entityId", "mimeType", "dataBase64", "sizeBytes", "updatedAt"]
    },
    "PortalConnection": {
      "title": "External Portal Connection Metadata",
      "description": "Phase 7 tenant-scoped external portal connection configuration and health status (zero secrets stored here)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 64 },
        "accountLabel": { "type": "string", "maxLength": 200 },
        "status": { "type": "string", "enum": ["disconnected", "connected", "expired", "error"] },
        "hasCredentials": { "type": "boolean" },
        "credentialKeyVersion": { "type": "number" },
        "lastTestedAt": { "type": "string", "format": "date-time" },
        "lastSyncedAt": { "type": "string", "format": "date-time" },
        "lastError": { "type": "string", "maxLength": 1000 },
        "settings": { "type": "object" },
        "updatedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "providerId", "accountLabel", "status", "hasCredentials", "createdAt", "updatedAt"]
    },
    "PortalSecret": {
      "title": "Envelope-Encrypted Portal Credentials",
      "description": "Phase 7 backend-only AES-256-GCM envelope-encrypted external portal credentials (denied to all clients in Firestore Rules)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 64 },
        "algorithm": { "type": "string", "enum": ["aes-256-gcm"] },
        "keyVersion": { "type": "number" },
        "aadVersion": { "type": "string", "enum": ["v1"] },
        "wrappedDekBase64": { "type": "string", "maxLength": 1024 },
        "wrappedDekIvBase64": { "type": "string", "maxLength": 256 },
        "wrappedDekTagBase64": { "type": "string", "maxLength": 256 },
        "ciphertextBase64": { "type": "string", "maxLength": 16384 },
        "ivBase64": { "type": "string", "maxLength": 256 },
        "authTagBase64": { "type": "string", "maxLength": 256 },
        "updatedBy": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "providerId", "algorithm", "keyVersion", "wrappedDekBase64", "ciphertextBase64", "updatedAt"]
    },
    "PortalPublication": {
      "title": "Per-Property External Portal Publication Record",
      "description": "Phase 7 publication lifecycle state, external listing ID, validation errors, and version sync tracking per property and portal",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "providerId": { "type": "string", "maxLength": 64 },
        "status": {
          "type": "string",
          "enum": [
            "not_published",
            "pending",
            "publishing",
            "published",
            "update_pending",
            "paused",
            "withdrawal_pending",
            "withdrawn",
            "rejected",
            "sync_error"
          ]
        },
        "externalListingId": { "type": "string", "maxLength": 200 },
        "externalUrl": { "type": "string", "maxLength": 1024 },
        "submittedVersion": { "type": "number" },
        "syncedVersion": { "type": "number" },
        "lastAttemptAt": { "type": "string", "format": "date-time" },
        "lastSyncedAt": { "type": "string", "format": "date-time" },
        "lastError": { "type": "string", "maxLength": 1000 },
        "lastErrorCode": { "type": "string", "maxLength": 100 },
        "retryCount": { "type": "number" },
        "validationErrors": { "type": "array" },
        "providerMeta": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "propertyId", "providerId", "status", "submittedVersion", "createdAt", "updatedAt"]
    },
    "PlatformTelemetryRollup": {
      "title": "Platform 5-Minute Telemetry Rollup",
      "description": "Phase 9 PII-free 5-minute platform performance rollup written only on non-zero activity with TTL expiration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "bucketStartIso": { "type": "string", "format": "date-time" },
        "bucketEndIso": { "type": "string", "format": "date-time" },
        "windowMinutes": { "type": "number" },
        "provenance": { "type": "string", "enum": ["core_api_measured"] },
        "apiRequests": { "type": "number" },
        "api4xx": { "type": "number" },
        "api5xx": { "type": "number" },
        "latencyP50Ms": { "type": "number" },
        "latencyP95Ms": { "type": "number" },
        "aiRequests": { "type": "number" },
        "aiPromptTokens": { "type": "number" },
        "aiOutputTokens": { "type": "number" },
        "aiTotalTokens": { "type": "number" },
        "estimatedAiCostEur": { "type": "number" },
        "activeUsersCount": { "type": "number" },
        "outboxCompleted": { "type": "number" },
        "outboxDeadLetter": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bucketStartIso", "bucketEndIso", "provenance", "apiRequests", "aiTotalTokens", "createdAt", "expiresAt"]
    },
    "PlatformAgencyUsageRollup": {
      "title": "Per-Agency 5-Minute Usage Rollup",
      "description": "Phase 9 PII-free per-agency usage attribution rollup (API, Gemini tokens/EUR, storage MB, portal sync counts) with TTL expiration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bucketId": { "type": "string", "maxLength": 64 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "bucketStartIso": { "type": "string", "format": "date-time" },
        "provenance": { "type": "string", "enum": ["core_api_measured"] },
        "apiRequests": { "type": "number" },
        "api4xx": { "type": "number" },
        "api5xx": { "type": "number" },
        "latencyP95Ms": { "type": "number" },
        "aiRequests": { "type": "number" },
        "aiPromptTokens": { "type": "number" },
        "aiOutputTokens": { "type": "number" },
        "aiTotalTokens": { "type": "number" },
        "estimatedAiCostEur": { "type": "number" },
        "topModel": { "type": "string", "maxLength": 64 },
        "storageMb": { "type": "number" },
        "portalPublishedCount": { "type": "number" },
        "portalSyncErrorCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "bucketId", "tenantId", "bucketStartIso", "provenance", "apiRequests", "aiTotalTokens", "createdAt", "expiresAt"]
    }
  },
  "firestore": {
    "public_shares/{shareId}": {
      "schema": { "$ref": "PublicShare" },
      "description": "Strictly sanitized PII-free public share snapshots readable by exact shareId without authentication"
    },
    "public_property_media/{mediaId}": {
      "schema": { "$ref": "PublicPropertyMedia" },
      "description": "Web-optimized public property listing images readable by deterministic SHA-256 mediaId across instances (never private documents)"
    },
    "platform_shared_leads/{leadId}": {
      "schema": { "$ref": "SharedLead" },
      "description": "Global auto-crawled leads managed by Super Admin and readable by signed-in agencies"
    },
    "platform_shared_leads_summary/{leadId}": {
      "schema": { "$ref": "SharedLeadSummary" },
      "description": "Phase 2 slim <=2.5 KB read-only projection of platform_shared_leads written atomically by backend Core API"
    },
    "platform_auto_crawl/{configId}": {
      "schema": { "$ref": "PlatformAutoCrawlConfig" },
      "description": "Super Admin auto-crawl schedule and filter settings"
    },
    "platform_settings/{settingId}": {
      "schema": { "$ref": "PlatformSettings" },
      "description": "Global platform configuration managed by Super Admins"
    },
    "platform_audit_logs/{logId}": {
      "schema": { "$ref": "PlatformAuditLog" },
      "description": "Individual immutable audit log records for Super Admin operations"
    },
    "automation_configs/{configId}": {
      "schema": { "$ref": "AutomationConfig" },
      "description": "Platform default and agency-scoped external ad title automation configs"
    },
    "tenants/{tenantId}": {
      "schema": { "$ref": "Tenant" },
      "description": "Root agency tenant document"
    },
    "tenants/{tenantId}/users/{userId}": {
      "schema": { "$ref": "TenantUser" },
      "description": "O(1) UID-keyed tenant membership records defining roles and permissions"
    },
    "tenants/{tenantId}/invites/{inviteEmail}": {
      "schema": { "$ref": "TenantUser" },
      "description": "O(1) email-keyed active staff invitations enabling zero-scan UID auto-binding on first sign-in"
    },
    "tenants/{tenantId}/counters/{counterKey}": {
      "schema": { "$ref": "EntityCounter" },
      "description": "Sharded per-entity-type atomic sequential ID counters"
    },
    "tenants/{tenantId}/settings/{settingId}": {
      "schema": { "$ref": "TenantSetting" },
      "description": "Agency-scoped configuration documents (e.g. market auto-import rules)"
    },
    "tenants/{tenantId}/admin_notes/{noteId}": {
      "schema": { "$ref": "AgencyAdminNote" },
      "description": "Super Admin administrative notes for an agency"
    },
    "tenants/{tenantId}/leads/{leadId}": {
      "schema": { "$ref": "Lead" },
      "description": "Agency-isolated real estate leads, properties, and requests"
    },
    "tenants/{tenantId}/leads_summary/{leadId}": {
      "schema": { "$ref": "LeadSummary" },
      "description": "Phase 2 slim <=2.5 KB read-only projection of tenant leads written atomically by backend Core API"
    },
    "tenants/{tenantId}/contacts/{contactId}": {
      "schema": { "$ref": "Contact" },
      "description": "Agency-isolated contacts"
    },
    "tenants/{tenantId}/staff/{staffId}": {
      "schema": { "$ref": "Staff" },
      "description": "Agency-isolated staff members"
    },
    "tenants/{tenantId}/personal/{personalId}": {
      "schema": { "$ref": "Staff" },
      "description": "Legacy agency staff subcollection (read/migration compatibility)"
    },
    "tenants/{tenantId}/documents/{documentId}": {
      "schema": { "$ref": "Document" },
      "description": "Agency-isolated documents"
    },
    "tenants/{tenantId}/activities/{activityId}": {
      "schema": { "$ref": "Activity" },
      "description": "Agency-isolated scheduled activities and viewings"
    },
    "tenants/{tenantId}/tours/{tourId}": {
      "schema": { "$ref": "Tour" },
      "description": "Agency-isolated tour viewing mirror records"
    },
    "tenants/{tenantId}/viewings/{viewingId}": {
      "schema": { "$ref": "Viewing" },
      "description": "Agency-isolated viewing reminder mirror records"
    },
    "tenants/{tenantId}/notifications/{notificationId}": {
      "schema": { "$ref": "Notification" },
      "description": "User-scoped notifications inside an agency"
    },
    "tenants/{tenantId}/fcm_tokens/{tokenId}": {
      "schema": { "$ref": "FcmToken" },
      "description": "User-scoped FCM push tokens inside an agency"
    },
    "tenants/{tenantId}/call_sessions/{callSid}": {
      "schema": { "$ref": "CallSession" },
      "description": "Phase 6 durable AI voice call session metadata (backend-written)"
    },
    "tenants/{tenantId}/call_sessions/{callSid}/events/{eventId}": {
      "schema": { "$ref": "CallSessionEvent" },
      "description": "Phase 6 ordered AI voice transcript events keyed by zero-padded monotonic seq"
    },
    "tenants/{tenantId}/portal_connections/{providerId}": {
      "schema": { "$ref": "PortalConnection" },
      "description": "Phase 7 tenant external portal connection metadata (no secrets; backend-written only)"
    },
    "tenants/{tenantId}/portal_secrets/{providerId}": {
      "schema": { "$ref": "PortalSecret" },
      "description": "Phase 7 envelope-encrypted portal credentials (100% locked from clients via Firestore Rules)"
    },
    "tenants/{tenantId}/portal_publications/{publicationId}": {
      "schema": { "$ref": "PortalPublication" },
      "description": "Phase 7 per-property external portal publication lifecycle tracking (backend-written only)"
    },
    "worker_leases/{lockKey}": {
      "schema": { "$ref": "WorkerLease" },
      "description": "Phase 6 distributed Firestore worker leases with monotonic fencing tokens"
    },
    "outbox_events/{eventId}": {
      "schema": { "$ref": "OutboxEvent" },
      "description": "Phase 6 transactional outbox queue with idempotency keys and DLQ replay"
    },
    "job_runs/{runId}": {
      "schema": { "$ref": "JobRun" },
      "description": "Phase 6 backend worker execution audit ledger"
    },
    "platform_telemetry_rollups/{rollupId}": {
      "schema": { "$ref": "PlatformTelemetryRollup" },
      "description": "Phase 9 PII-free 5-minute platform performance rollups (Super Admin read-only, backend-written only, 60-day TTL)"
    },
    "platform_agency_usage_rollups/{rollupId}": {
      "schema": { "$ref": "PlatformAgencyUsageRollup" },
      "description": "Phase 9 PII-free 5-minute per-agency usage attribution rollups (Super Admin read-only, backend-written only, 90-day TTL)"
    }
  }
}
