{
  "entities": {
    "Lead": {
      "title": "Real Estate Lead / Property / Request",
      "description": "Tenant-isolated agency lead, active property listing, or client request (cerere)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "tenantId": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 64 },
        "url": { "type": "string", "maxLength": 2048 },
        "title": { "type": "string", "maxLength": 500 },
        "zone": { "type": "string", "maxLength": 200 },
        "price": { "type": "string", "maxLength": 100 },
        "ownerName": { "type": "string", "maxLength": 200 },
        "ownerPhone": { "type": "string", "maxLength": 100 },
        "transactionType": { "type": "string", "enum": ["Vânzare", "Închiriere"] },
        "categoria": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "maxLength": 64 },
        "extractedData": { "type": "object" },
        "createdByUid": { "type": "string", "maxLength": 128 },
