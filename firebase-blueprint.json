{
  "entities": {
    "Lead": {
      "title": "Real Estate Lead",
      "description": "A potential property lead for crawling and processing",
      "type": "object",
      "properties": {
        "url": { "type": "string", "description": "The listing URL" },
        "title": { "type": "string", "description": "Property title" },
        "zone": { "type": "string", "description": "Property location zone" },
        "price": { "type": "string", "description": "Property price" },
        "ownerName": { "type": "string", "description": "Name of the owner/contact" },
        "ownerPhone": { "type": "string", "description": "Phone number of the owner/contact" },
        "transactionType": { "type": "string", "enum": ["Vânzare", "Închiriere"] },
        "categoria": { "type": "string", "enum": ["Apartamente", "Case / Vile", "Terenuri", "Spatii birouri", "Spatii comerciale", "Spatii industriale", "Spatii depozitare", "Hale", "Alte tipuri"] },
        "status": { "type": "string", "enum": ["Lead-uri", "Prospectare", "Publicare", "Cerere", "Vizionare", "Semnare", "Arhiva", "Sterse"] },
        "extractedData": { "type": "object", "description": "Full Gemini extraction result" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastMovedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "status", "createdAt", "updatedAt"]
    },
    "Contact": {
      "title": "Property Contact",
      "description": "An owner, renter, or buyer associated with a property",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "type": { "type": "string", "enum": ["Owner", "Renter", "Buyer", "Agent"] },
        "phone": { "type": "string" },
        "propertyId": { "type": "string", "description": "Manual text ID of the associated property" },
        "commissionValue": { "type": "string", "description": "Optional commission details" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["firstName", "lastName", "type", "phone", "propertyId", "createdAt", "updatedAt"]
    },
    "Viewing": {
      "title": "Property Viewing",
      "description": "A scheduled meeting between an agent, owner, and potential client",
      "type": "object",
      "properties": {
        "propertyId": { "type": "string" },
        "contactId": { "type": "string" },
        "contactName": { "type": "string" },
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "hour": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyId", "contactId", "contactName", "date", "hour", "createdAt", "updatedAt"]
    },
    "Staff": {
      "title": "Agency Staff Member",
      "description": "An agent, broker, manager, or staff member in the agency",
      "type": "object",
      "properties": {
        "staffId": { "type": "string", "description": "Sequential ID formatted as S1, S2, S1026" },
        "personalId": { "type": "string", "description": "Legacy alias for staffId" },
        "tenantId": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["Activ", "Inactiv", "active", "inactive"] },
        "zone": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "phone", "status", "createdAt", "updatedAt"]
    },
    "Personal": {
      "title": "Legacy Agency Staff Member",
      "description": "Legacy staff member record (migrated to Staff)",
      "type": "object",
      "properties": {
        "personalId": { "type": "string", "description": "Sequential ID formatted as S1, S2, S1026" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "status": { "type": "string", "enum": ["Activ", "Inactiv"] },
        "zone": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "phone", "status", "createdAt", "updatedAt"]
    },
    "Document": {
      "title": "Property Document",
      "description": "Contracts, title deeds, floor plans, energy certificates, and identity files",
      "type": "object",
      "properties": {
        "documentId": { "type": "string", "description": "Sequential ID formatted as D01, D02, D1029" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "propertyId": { "type": "string" },
        "clientId": { "type": "string" },
        "staffId": { "type": "string" },
        "fileUrl": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "type", "createdAt", "updatedAt"]
    },
    "Tour": {
      "title": "Property Tour Viewing",
      "description": "A scheduled property tour viewing with a client and staff member",
      "type": "object",
      "properties": {
        "tourId": { "type": "string", "description": "Sequential ID formatted as T1, T2, T1021" },
        "propertyId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "hour": { "type": "string" },
        "status": { "type": "string", "enum": ["Programată", "Realizată", "Anulată"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["propertyId", "clientName", "date", "hour", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Agency Activity",
      "description": "A scheduled activity such as property viewing, meeting, call, inspection, or task",
      "type": "object",
      "properties": {
        "activityId": { "type": "string", "description": "Sequential ID formatted as A1, A2, A1022" },
        "propertyId": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "clientPhone": { "type": "string" },
        "staffId": { "type": "string" },
        "staffName": { "type": "string" },
        "type": { "type": "string", "description": "Vizionare, Întâlnire, Apel, Notă, Evaluare, Altele" },
        "date": { "type": "string", "format": "date" },
        "hour": { "type": "string" },
        "status": { "type": "string", "enum": ["Programată", "Realizată", "Anulată"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientName", "date", "hour", "createdAt", "updatedAt"]
    },
    "Tenant": {
      "title": "Agency Tenant",
      "description": "Independent real-estate agency tenant with custom branding, quotas and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subdomain": { "type": "string" },
        "customDomain": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "trial", "active", "suspended", "cancelled"] },
        "planId": { "type": "string" },
        "branding": { "type": "object" },
        "enabledModules": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "subdomain", "name", "status", "createdAt", "updatedAt"]
    },
    "TenantUser": {
      "title": "Agency Tenant Member",
      "description": "User membership record linking a user identity to an agency tenant with an RBAC role",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["agency_owner", "agency_admin", "manager", "agent", "assistant"] },
        "status": { "type": "string", "enum": ["invited", "active", "suspended", "revoked"] },
        "permissions": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "userId", "email", "role", "status", "createdAt", "updatedAt"]
    },
    "AutomationConfig": {
      "title": "Agency Automation Rule Config",
      "description": "Agency-scoped configuration for external ad title formatting rules, category priorities, and character bounds",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "titleRule": { "type": "object" },
        "version": { "type": "number" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tenantId", "titleRule", "updatedAt"]
    }
  },
  "firestore": {
    "tenants/{tenantId}": {
      "schema": { "$ref": "Tenant" },
      "description": "Root agency tenant document"
    },
    "tenants/{tenantId}/users/{userId}": {
      "schema": { "$ref": "TenantUser" },
      "description": "Tenant membership records defining roles and permissions"
    },
    "tenants/{tenantId}/automation/{ruleId}": {
      "schema": { "$ref": "AutomationConfig" },
      "description": "Agency-isolated automation rules for external ad extraction"
    },
    "tenants/{tenantId}/staff/{staffId}": {
      "schema": { "$ref": "Staff" },
      "description": "Agency-isolated staff members"
    },
    "tenants/{tenantId}/leads/{leadId}": {
      "schema": { "$ref": "Lead" },
      "description": "Agency-isolated real estate leads"
    },
    "tenants/{tenantId}/contacts/{contactId}": {
      "schema": { "$ref": "Contact" },
      "description": "Agency-isolated contacts"
    },
    "tenants/{tenantId}/documents/{documentId}": {
      "schema": { "$ref": "Document" },
      "description": "Agency-isolated documents"
    },
    "tenants/{tenantId}/activities/{activityId}": {
      "schema": { "$ref": "Activity" },
      "description": "Agency-isolated scheduled activities and viewings"
    },
    "leads": {
      "schema": { "$ref": "Lead" },
      "description": "Legacy collection of real estate leads (preserved for backward compatibility)"
    },
    "contacts": {
      "schema": { "$ref": "Contact" },
      "description": "Legacy collection of property contacts (preserved for backward compatibility)"
    },
    "personal": {
      "schema": { "$ref": "Personal" },
      "description": "Legacy collection of agency staff (preserved for backward compatibility)"
    },
    "documents": {
      "schema": { "$ref": "Document" },
      "description": "Legacy collection of agency and property documents"
    },
    "activities": {
      "schema": { "$ref": "Activity" },
      "description": "Legacy collection of agency activities"
    },
    "tours": {
      "schema": { "$ref": "Tour" },
      "description": "Legacy collection of scheduled tours"
    },
    "viewings": {
      "schema": { "$ref": "Viewing" },
      "description": "Legacy collection of scheduled property viewings"
    }
  }
}
