# Core Runtime
NODE_ENV=development
APP_URL=http://localhost:3000

# Gemini AI (Server-Side Only - Never prefix with VITE_)
GEMINI_API_KEY=

# Maps & Web Push (Optional Client Keys)
GOOGLE_MAPS_PLATFORM_KEY=
VITE_FIREBASE_VAPID_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@brokr.ro

# Firebase / Firestore Multi-Instance Server Credentials (Production Recommended)
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
USE_GCP_METADATA_AUTH=false
ALLOW_PREVIEW_METADATA_AUTH=false

# Multi-Tenant Routing
PLATFORM_ROOT_DOMAIN=highline.ro
PLATFORM_ADMIN_SUBDOMAIN=admin
PLATFORM_PUBLIC_URL=https://highline.ro

# Security & Preview Mode
ALLOW_PREVIEW_MODE_IN_PRODUCTION=false
ALLOW_MOCK_BILLING_IN_PRODUCTION=false
REQUIRE_TWILIO_SIGNATURE=false

# Stripe Billing (Required in production unless ALLOW_MOCK_BILLING_IN_PRODUCTION=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Twilio AI Voice Calls (Required together when voice calls enabled)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Persistent Cloud Storage (GCS / Firebase Storage)
GCS_BUCKET_NAME=
GCS_BUCKET_LOCATION=europe-west3
STORAGE_SIGNING_SECRET=
GCS_EMULATOR_HOST=

# Optional Crawler Relay / Proxy Fallback (e.g., https://your-worker.workers.dev/?url={url})
CRAWL_RELAY_URL=
